# ============================================
# CENTRO DE MANDO ATP — Environment Variables (Template)
# ============================================

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="<redactado>"
SMTP_PASS="<redactado>"
SMTP_FROM="Supervisión Escolar ATP <<redactado>>"

# Database (PostgreSQL)
DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"

# ── GEMINI API ───────────────────────────────────────────────
GEMINI_API_KEY="<redactado>"

# NextAuth.js
AUTH_SECRET="<redactado>"
NEXTAUTH_URL="http://localhost:3000"

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME="<redactado>"
CLOUDINARY_API_KEY="<redactado>"
CLOUDINARY_API_SECRET="<redactado>"

# Google Drive (opcional)
GOOGLE_DRIVE_FOLDER_ID="<redactado>"
GOOGLE_CLIENT_EMAIL="<redactado>"
GOOGLE_PRIVATE_KEY="<redactado>"

# --- Configuración institucional ---
APP_URL="https://sacrint-sisat-atp.vercel.app"

# --- Cron / Jobs Secret ---
CRON_SECRET=""

# --- Seed de desarrollo ---
SEED_ADMIN_EMAIL="atp@supervision.edu.mx"
SEED_ADMIN_PASSWORD="<redactado>"
SEED_SCHOOL_PASSWORD="<redactado>"
SEED_SCHOOL_EMAIL_DOMAIN="seppue.gob.mx"

# --- Rutas de prompts maestros ---
PROMPT_PMC_DOCX_PATH=""
PROMPT_PAEC_DOCX_PATH=""
